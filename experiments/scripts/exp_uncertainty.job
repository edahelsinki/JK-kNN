#!/bin/bash -l
#SBATCH --job-name=uncertainty
#SBATCH -o experiments/logs/%A_uncertainty.log
#SBATCH --partition=q64,q48,q40
#SBATCH --mem=12G
#SBATCH --cpus-per-task=16
#SBATCH --time=12:00:00

echo "========= Job started  at `date` =========="
echo "Job started with arguments: $@"

CURR_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
PROJECT_ROOT="$(dirname "$(dirname "$CURR_DIR")")"
CONFIG="$PROJECT_ROOT/config.sh"
# shellcheck source=/dev/null
. "$CONFIG"
SRC_DIR=$1
REPR=$2

source "$JKCS_PATH/JKQC/JKCS/bin/activate"
ml load python/3.11.1
source "$JKCS_PATH/JKQC/JKCS/bin/activate"
python3 experiments/uncertainty_estimation.py "$SRC_DIR" "$SRC_DIR" "$REPR"
echo "========= Job finished at `date` =========="
